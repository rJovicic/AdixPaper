# Local development. In Railway, set these on the AdixPaper service (see DEPLOYMENT.md).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adixpaper
# Required in production; generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Only needed if another origin must call the API directly (comma-separated).
CORS_ORIGINS=

# First admin account, created on first start if no admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false
ADMIN_IME=Admin
ADMIN_PREZIME=Adix
ADMIN_EMAIL=
ADMIN_TELEFON=
ADMIN_ODJEL=Administracija
AUTO_SEED_SPARE_PARTS=true
# One-off password reset for any user; clear after use.
RESET_USERNAME=
RESET_PASSWORD=

# Optional Web Push (generate a VAPID key pair).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@adixpaper.com
